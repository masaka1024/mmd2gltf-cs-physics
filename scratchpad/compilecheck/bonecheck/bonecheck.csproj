<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <OutputType>Exe</OutputType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>BoneCheck</AssemblyName>
    <StartupObject>BoneCheck.Program</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <!-- UnityEngine 最小シム (compilecheck 直下と共用) -->
    <Compile Include="..\UnityShim.cs" />
    <!-- ローカルの計測コード -->
    <Compile Include="BoneCsv.cs" />
    <Compile Include="Program.cs" />
    <!-- 検証対象のエンジン本体 (リポジトリ相対、読み取りのみ) -->
    <Compile Include="..\..\..\Assets\Scripts\**\*.cs" />
  </ItemGroup>
</Project>
