# build 生成物 (どこでも無視。tools/ のソースは追跡する)
bin/
obj/
*.user

# --- モデル/モーションデータ (再配布回避。各自用意し testdata/ か環境変数で指定) ---
# ハーネス/診断ツールと BonePoseCsvPlayer は testdata/ を既定の探索先にしている。
# testdata/ 運用に移行済みなら下の個別CSV名指しは本来不要 (念のため二重に弾いている)。
testdata/
*.pmx
*.pmd
*.vmd
*.vpd
*.fbx
# ベイク/構造エクスポートCSV (モデル名に依らないパターンで弾く。
# testdata/ 配下は上の行で既に除外済みなので、これは念のための二重の網)
*bone_world_pose*.csv
*_structure.csv
# 診断ツールが吐く計測CSV (通常 bin/ 配下なので bin/ で既に除外されるが、拡張子でも二重に弾く)
*_perframe.csv
*_timeseries.csv

# --- Unity (将来フルプロジェクト化する場合) ---
# ※ ハーネスの手書き .csproj (tools/ 配下) は追跡必須なので *.csproj は無視しない。
#    Unity が自動生成する分だけ名指しで無視する。
Assembly-CSharp*.csproj
*.sln
Library/
Temp/
Logs/
UserSettings/
.vs/
.idea/
.vscode/

# --- 診断ツールの実行結果 (ソースではないので追跡しない。2026-08-22) ---
# 各ツールは計測結果を自分のディレクトリへ .txt/.csv で吐く。モデル名やローカル絶対パスが
# 混ざるうえ再生成できるので、リポジトリには入れない。ソース (.cs/.py/.cpp/.bat/.rsp/.md) は追跡する。
tools/**/*.txt
tools/**/*.csv
__pycache__/

# bulletref は作業ディレクトリ (t21/t34/eps/...) に exe と計測結果を大量に置くので、
# ソースだけを名指しで通す (ホワイトリスト方式)。
tools/diagnostics/bulletref/*
!tools/diagnostics/bulletref/*.cpp
!tools/diagnostics/bulletref/*.py
!tools/diagnostics/bulletref/*.bat
!tools/diagnostics/bulletref/lib.rsp
!tools/diagnostics/bulletref/README_bulletref.md

# 静止3つ組のランナーはローカルのモデル置き場を直書きするので追跡しない
# (t70/t71/t72 と同じ扱い)。
tools/diagnostics/restosc/t7?_static.ps1
tools/diagnostics/restosc/t77_lever2.ps1

# 計測ランナー (.ps1) はローカルのモデル実ファイル名を直書きするので追跡しない。
# 実行条件は docs/DESIGN.md 側に env 名で残すこと。
tools/**/t[0-9][0-9]_*.ps1
